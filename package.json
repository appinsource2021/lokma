{
  "name": "lokma",
  "private": true,
  "packageManager": "pnpm@10.28.0",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "pnpm -r --parallel --filter @lokma/api --filter @lokma/web dev",
    "build": "pnpm -r build",
    "typecheck": "pnpm -r typecheck",
    "test": "pnpm -r test",
    "db:setup": "bash scripts/dev-db.sh",
    "db:migrate": "pnpm --filter @lokma/api db:migrate",
    "db:seed": "pnpm --filter @lokma/api db:seed"
  }
}
